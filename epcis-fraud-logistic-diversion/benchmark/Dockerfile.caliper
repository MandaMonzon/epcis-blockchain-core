FROM hyperledger/caliper:0.6.0
USER root
COPY fabric-bindings/ /tmp/fabric-bindings/
RUN cd /home/node/.npm-global/lib/node_modules/@hyperledger/caliper-cli/node_modules/@hyperledger/caliper-fabric && \
    npm install --prefer-offline /tmp/fabric-bindings/hyperledger-fabric-gateway-1.5.0.tgz /tmp/fabric-bindings/grpc-grpc-js-1.10.3.tgz
USER node
